{
  "name": "dm-iso-360",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:ai:fallback": "node --test src/engines/ai-analyzer/geminiClient.test.ts",
    "test:ai:gemini": "node --env-file=.env.local --experimental-strip-types src/engines/ai-analyzer/smokeGemini.ts",
