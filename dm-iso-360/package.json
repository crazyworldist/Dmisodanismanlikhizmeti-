    "test:ai:assistant": "node --env-file=.env.local --experimental-strip-types src/app/api/assistant/smokeAssistant.ts",
    "test:ai:fallback:all": "npm run test:ai:fallback && npm run test:ai:assistant:fallback",
    "test:ai:all": "npm run test:ai:fallback && npm run test:ai:assistant:fallback && npm run test:ai:gemini && npm run test:ai:assistant"
  },
  "dependencies": {
    "next": "15.2.0",
